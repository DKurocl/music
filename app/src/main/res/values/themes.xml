<resources>
    <style name="Theme.Music" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- The page color of the app (wallpaper colors), so the start shows no other color. -->
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <!-- The mark alone on the page colour, no disc behind it, animated for a moment (docs/design/icon.py). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
    </style>
</resources>
