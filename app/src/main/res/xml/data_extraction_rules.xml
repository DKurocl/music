<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: no cloud backup, no device-to-device transfer. The library is a cache
     of the files, and what is not (playlists, history) gets its own export when it exists. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
