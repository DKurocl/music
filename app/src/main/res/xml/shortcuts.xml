<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the four things opened most, one tap each. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="resume" android:enabled="true" android:icon="@drawable/shortcut_resume"
        android:shortcutShortLabel="@string/shortcut_resume" android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent android:action="ua.olex.music.action.RESUME" android:targetPackage="ua.olex.music" android:targetClass="ua.olex.music.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="shuffle" android:enabled="true" android:icon="@drawable/shortcut_shuffle"
        android:shortcutShortLabel="@string/shortcut_shuffle" android:shortcutLongLabel="@string/shortcut_shuffle_long">
        <intent android:action="ua.olex.music.action.SHUFFLE_ALL" android:targetPackage="ua.olex.music" android:targetClass="ua.olex.music.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="liked" android:enabled="true" android:icon="@drawable/shortcut_liked"
        android:shortcutShortLabel="@string/shortcut_liked" android:shortcutLongLabel="@string/shortcut_liked_long">
        <intent android:action="ua.olex.music.action.LIKED" android:targetPackage="ua.olex.music" android:targetClass="ua.olex.music.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="search" android:enabled="true" android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search" android:shortcutLongLabel="@string/shortcut_search_long">
        <intent android:action="ua.olex.music.action.SEARCH" android:targetPackage="ua.olex.music" android:targetClass="ua.olex.music.MainActivity" />
    </shortcut>
</shortcuts>
