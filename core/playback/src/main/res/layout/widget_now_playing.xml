<?xml version="1.0" encoding="utf-8"?>
<!-- Two rows: cover on the left; song and artist at the top of the column, previous / play / next
     at its bottom, a flexible gap between. When the widget is short the gap gives way, never the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:clipToOutline="true"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="70dp" android:layout_height="70dp"
        android:background="@drawable/widget_art" android:clipToOutline="true" android:scaleType="centerCrop"
        android:src="@drawable/widget_note" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/w_title" android:textSize="15sp" android:fontFamily="google-sans-text" android:textFontWeight="500"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/widget_idle" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/w_sub" android:textSize="13sp" android:fontFamily="google-sans-text" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:layout_marginTop="2dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginStart="-8dp">
            <ImageButton android:id="@+id/widget_previous" android:layout_width="40dp" android:layout_height="32dp" android:background="@null"
                android:src="@drawable/widget_previous" android:tint="@color/w_icon" android:contentDescription="@string/widget_previous" />
            <ImageButton android:id="@+id/widget_play" android:layout_width="52dp" android:layout_height="32dp" android:layout_marginHorizontal="6dp"
                android:background="@drawable/widget_button" android:src="@drawable/widget_play" android:tint="@color/w_on_play"
                android:contentDescription="@string/widget_play" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="32dp" android:background="@null"
                android:src="@drawable/widget_next" android:tint="@color/w_icon" android:contentDescription="@string/widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
