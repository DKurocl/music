<?xml version="1.0" encoding="utf-8"?>
<!-- The media card of the shade, on the home screen: the cover the full height of the card; song
     and artist at the top of the column; previous / play / next sharing its width in equal parts at
     the bottom. When the widget is short the gap between gives way, never the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:clipToOutline="true"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="10dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="72dp" android:layout_height="72dp"
        android:background="@drawable/widget_art" android:clipToOutline="true" android:scaleType="centerCrop"
        android:src="@drawable/widget_note" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/w_title" android:textSize="15sp" android:fontFamily="google-sans-text" android:textFontWeight="500"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/widget_idle" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/w_sub" android:textSize="13sp" android:fontFamily="google-sans-text" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:layout_marginTop="2dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="36dp" android:layout_gravity="center"
                    android:background="@null" android:src="@drawable/widget_previous" android:tint="@color/w_icon" android:contentDescription="@string/widget_previous" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton android:id="@+id/widget_play" android:layout_width="56dp" android:layout_height="36dp" android:layout_gravity="center"
                    android:background="@drawable/widget_button" android:src="@drawable/widget_play" android:tint="@color/w_on_play"
                    android:contentDescription="@string/widget_play" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="36dp" android:layout_gravity="center"
                    android:background="@null" android:src="@drawable/widget_next" android:tint="@color/w_icon" android:contentDescription="@string/widget_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
