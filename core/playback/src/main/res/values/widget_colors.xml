<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- As Google's own widgets on Pixel (Weather, Gemini, Watchlist): a tonal surface from the
         wallpaper's secondary palette (the dark one measures #2A3042 on the owner's phone, tone 800),
         text in neutral tones, and one light accent pill for the main action. Not near-black
         surface roles: those read as a hole in the home screen next to every other widget. -->
    <color name="w_bg">@android:color/system_accent2_50</color>
    <color name="w_title">@android:color/system_neutral1_900</color>
    <color name="w_sub">@android:color/system_neutral2_700</color>
    <color name="w_icon">@android:color/system_accent2_900</color>
    <color name="w_play">@android:color/system_accent1_600</color>
    <color name="w_on_play">@android:color/system_accent1_0</color>
    <color name="w_art">@android:color/system_accent2_100</color>
</resources>
