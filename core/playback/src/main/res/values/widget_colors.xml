<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The widget is the app's mini player on the home screen: Material 3's own roles from the
         system (surface container, on-surface, primary), as the app's player uses them, the one
         accent kept for play. -->
    <color name="w_bg">@android:color/system_surface_container_light</color>
    <color name="w_title">@android:color/system_on_surface_light</color>
    <color name="w_sub">@android:color/system_on_surface_variant_light</color>
    <color name="w_icon">@android:color/system_on_surface_variant_light</color>
    <color name="w_play">@android:color/system_primary_light</color>
    <color name="w_on_play">@android:color/system_on_primary_light</color>
    <color name="w_art">@android:color/system_surface_container_highest_light</color>
</resources>
